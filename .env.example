# Copy to .env for local testing of the paid setup (python-dotenv is not needed: `set -a; . ./.env; set +a`).
# Leave everything unset to run locally with no sign-in, as before.

GRIDSIM_ENV=production            # production = sign-in required, refuses to start if anything below is missing
APP_URL=http://localhost:8000     # public address of the app (Stripe sends people back here)

# Supabase (Project settings -> API, and Project settings -> Database)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=              # only if your project still uses the shared JWT secret; newer projects use signing keys and need only SUPABASE_URL
DATABASE_URL=                     # Supabase "Connection string" (Session pooler is fine)

# Encrypts saved ESPN cookies. Keep it safe: lose it and users re-enter their cookies.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GRIDSIM_SECRET_KEY=

# Stripe (Developers -> API keys / Webhooks / Product catalog)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_MONTHLY=price_
STRIPE_PRICE_SEASON=price_
STRIPE_TRIAL_DAYS=0               # free days on the monthly plan; 0 = no trial
STRIPE_AUTOMATIC_TAX=0            # 1 once Stripe Tax is set up

GRIDSIM_ADMIN_EMAILS=you@example.com   # may press "Update data"
GRIDSIM_REFRESH_HOURS=6                # re-download data and rebuild the model every N hours (0 = off)
GRIDSIM_RATE_PER_MIN=60                # per-user cap on simulation/league requests
GRIDSIM_MAX_LEAGUES=10
GRIDSIM_MODEL=                         # path for model.json on a persistent disk (the Docker image sets /app/data/model.json)
